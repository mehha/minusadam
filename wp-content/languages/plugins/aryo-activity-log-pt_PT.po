msgid "date_from and date_to must both be set."
msgstr "tanto a data de início como a data de fim devem estar definidas"

#: classes/class-aal-log-query.php:675
msgid "Provide either period or date_from/date_to, not both."
msgstr "Indique um periodo ou datas de início e fim, mas não ambos."

