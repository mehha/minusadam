msgid "Invalid period value."
msgstr "Valor de período inválido."

#: classes/class-aal-log-query.php:710
msgid "The date range may not exceed 90 days."
msgstr "O intervalo de datas não pode exceder 90 dias."

#: classes/class-aal-log-query.php:701
msgid "date_from must not be after date_to."
msgstr "a data de início não pode ser posterior à data de fim"

