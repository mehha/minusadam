#: src/StoreApi/Utilities/OrderController.php:311
msgid "Sorry, the address on this order cannot be changed because the tax was calculated for the original address. Please use the original address, or contact us to have the order updated."
msgstr "Vabandust, selle tellimuse aadressi ei saa muuta, sest maks arvutati algse aadressi alusel. Palun kasuta algset aadressi või võta meiega ühendust, et tellimust uuendada."

#: src/StoreApi/Utilities/OrderController.php:300
msgid "Sorry, the shipping address on this order cannot be changed because the shipping cost was calculated for the original address. Please use the original address, or contact us to have the order updated."
msgstr "Kahjuks ei saa selle tellimuse tarneaadressi muuta, sest saatmiskulu arvutati algse aadressi põhjal. Palun kasuta algset aadressi või võta meiega ühendust, et tellimust uuendada."

#. translators: %s: the error that was raised after payment was taken.
#: src/StoreApi/Utilities/CheckoutTrait.php:287
msgid "Checkout could not be completed after payment was taken: %s"
msgstr "Kassat ei saanud pärast makse sooritamist lõpule viia: %s"

#: src/StoreApi/Schemas/V1/CartItemSchema.php:37
msgid "Key of the parent cart item, or null if this item is standalone."
msgstr "Ülem-ostukorvi eseme võti või null, kui see ese on eraldiseisev."

#: src/StoreApi/Routes/V1/Ucp/CatalogSearch.php:232
msgid "filters.price.min must not exceed filters.price.max."
msgstr "filters.price.min ei tohi ületada filters.price.max."

#. translators: %s: price filter bound name, `min` or `max`.
#: src/StoreApi/Routes/V1/Ucp/CatalogSearch.php:218
msgid "filters.price.%s must be a non-negative amount in minor units."
msgstr "filters.price.%s peab olema mittenegatiivne summa väiksemates ühikutes."

#: src/StoreApi/Routes/V1/Ucp/CatalogSearch.php:194
msgid "A query or at least one supported filter (categories, price) is required."
msgstr "Nõutav on päring või vähemalt üks toetatud filter (kategooriad, hind)."

#. translators: %d: maximum accepted query length in characters.
#: src/StoreApi/Routes/V1/Ucp/CatalogSearch.php:178
msgid "query exceeds the maximum length of %d characters."
msgstr "päring ületab maksimaalse pikkuse %d tähemärki."

#: src/StoreApi/Routes/V1/Ucp/CatalogSearch.php:85
msgid "Requested page size and cursor."
msgstr "Taotletud lehe suurus ja kursor."

#: src/StoreApi/Routes/V1/Ucp/CatalogSearch.php:81
msgid "Filter criteria to narrow search results."
msgstr "Filtrikriteeriumid otsingutulemuste kitsendamiseks."

#: src/StoreApi/Routes/V1/Ucp/CatalogSearch.php:77
msgid "Free-text search query."
msgstr "Vabateksti otsingupäring."

#. translators: %d: maximum number of selected options accepted per request.
#: src/StoreApi/Routes/V1/Ucp/CatalogProduct.php:102
msgid "selected accepts at most %d options per request."
msgstr "selected aktsepteerib ühe päringu kohta kuni %d valikut."

#: src/StoreApi/Routes/V1/Ucp/CatalogProduct.php:70
msgid "Option selections used to narrow the returned variants."
msgstr "Valikuvalikud, mida kasutatakse tagastatud variantide kitsendamiseks."

#: src/StoreApi/Routes/V1/Ucp/CatalogProduct.php:66
msgid "Product or variant identifier."
msgstr "Toote või variandi identifikaator."

#. translators: %s: product identifier.
#: src/StoreApi/Routes/V1/Ucp/CatalogLookup.php:133
msgid "Product \"%s\" not found."
msgstr "Toodet \"%s\" ei leitud."

#. translators: %d: maximum number of ids accepted per lookup request.
#: src/StoreApi/Routes/V1/Ucp/CatalogLookup.php:104
msgid "ids accepts at most %d entries per request."
msgstr "ids aktsepteerib päringu kohta kuni %d kirjet."

#: src/StoreApi/Routes/V1/Ucp/CatalogLookup.php:69
msgid "Product or variant identifiers to look up."
msgstr "Otsitavad toote või variandi identifikaatorid."

#. translators: 1: requested currency code, 2: store currency code.
#: src/StoreApi/Routes/V1/Ucp/AbstractCatalogRoute.php:273
msgid "This store only transacts in %2$s and does not convert currencies. Prices are returned in %2$s; the requested currency %1$s was ignored."
msgstr "See pood teeb tehinguid ainult valuutas %2$s ega teisenda valuutasid. Hinnad tagastatakse valuutas %2$s; taotletud valuutat %1$s eirati."

#. translators: 1: number of variants returned, 2: total published variants, 3:
#. product title.
#: src/StoreApi/Routes/V1/Ucp/AbstractCatalogRoute.php:239
msgid "Showing %1$d of %2$d variants for \"%3$s\". Request this product directly, or name a variant by id, to reach the others."
msgstr "Kuvatakse %1$d varianti %2$d variandist toote %3$s jaoks. Taotle seda toodet otse või nimeta variant ID järgi, et jõuda teisteni."

#: src/StoreApi/Routes/V1/Ucp/AbstractCatalogRoute.php:71
msgid "Provisional buyer signals for relevance and localization."
msgstr "Ajutised ostja signaalid asjakohasuse ja lokaliseerimise jaoks."

#. translators: 1: restocked product names, 2: URL of the Back in Stock
#. Notifications page
#: src/Internal/StockNotifications/StockSyncController.php:232
msgid "Back-in-stock notifications for %1$s have been queued. Subscribed customers will receive these emails shortly. You can monitor or manage individual subscriptions on the <a href=\"%2$s\">Stock Notifications page</a>."
msgstr "Laos tagasioleku teavitused tootele %1$s on järjekorda lisatud. Tellinud kliendid saavad need e-kirjad peagi. Saad jälgida või hallata üksikuid tellimusi lehel <a href=\"%2$s\">Laoteavitused</a>."

#: src/Internal/StockNotifications/Emails/EmailActionController.php:243
msgid "This unsubscribe link is no longer valid."
msgstr "See tellimuse tühistamise link ei ole enam kehtiv."

#: src/Internal/StockNotifications/Emails/EmailActionController.php:242
msgid "This verification link is no longer valid. Please use the link in the most recent verification email."
msgstr "See kinnituslink ei kehti enam. Palun kasuta linki kõige värskemas kinnitusmeilis."

#: src/Internal/StockNotifications/Emails/EmailActionController.php:217
msgid "You are already unsubscribed from this notification."
msgstr "Oled selle teavituse tellimusest juba loobunud."

#: src/Internal/StockNotifications/Emails/EmailActionController.php:213
msgid "This notification has already been sent, so there is nothing to unsubscribe from."
msgstr "See teavitus on juba saadetud, seega pole millestki loobuda."

#: src/Internal/StockNotifications/Emails/EmailActionController.php:168
msgid "This verification link has expired. Sign up again to request a new one."
msgstr "See kinnituslink on aegunud. Uue taotlemiseks registreeru uuesti."

#: src/Internal/StockNotifications/Emails/EmailActionController.php:163
msgid "This sign-up has already been verified."
msgstr "See registreerumine on juba kinnitatud."

#: src/Internal/StockNotifications/Emails/EmailActionController.php:162
msgid "This sign-up has been cancelled, so it can no longer be verified."
msgstr "See registreerumine on tühistatud, seega ei saa seda enam kinnitada."

#: src/Internal/StockNotifications/Admin/SettingsController.php:197
msgid "When enabled, guests see a login prompt instead of the sign-up form."
msgstr "Kui see on lubatud, näevad külalised registreerimisvormi asemel sisselogimisviipa."

#: src/Internal/StockNotifications/Admin/SettingsController.php:192
msgid "Require login"
msgstr "Nõua sisselogimist"

#: src/Internal/StockNotifications/Admin/SettingsController.php:180
msgid "Controls how long unverified notification sign-ups are stored in the database. Enter zero, or leave this field empty, to store unverified sign-up requests indefinitely."
msgstr "Määrab, kui kaua kinnitamata teavituste tellimusi andmebaasis säilitatakse. Sisesta null või jäta see väli tühjaks, et säilitada kinnitamata tellimistaotlusi tähtajatult."

#: src/Internal/Shipping/FlatRate/WeightPlaceholder.php:103
msgid "The [weight] min value cannot be greater than the max value."
msgstr "[weight] miinimumväärtus ei saa olla suurem kui maksimumväärtus."

#. translators: %s: weight placeholder attribute, either min or max.
#: src/Internal/Shipping/FlatRate/WeightPlaceholder.php:92
msgid "The [weight] %s value must be a non-negative number with a dot decimal separator and no thousands separators, e.g. 1000.5."
msgstr "[weight] %s väärtus peab olema mittenegatiivne arv, mille kümnendkoha eraldaja on punkt ja millel puuduvad tuhandete eraldajad, nt 1000.5."

#. translators: %s: payment method title.
#: src/Internal/RestApi/Routes/V4/Settings/PaymentGateways/Schema/AbstractPaymentGatewaySettingsSchema.php:408
msgid "Choose which shipping methods support %s."
msgstr "Vali, millised saatmise viisid toetavad %s."

#: src/Internal/PushNotifications/Controllers/StepLogRestController.php:296
msgid "Latest Unix timestamp to include. Defaults to now."
msgstr "Viimane kaasatav Unixi ajatempel. Vaikimisi praegune aeg."

#: src/Internal/PushNotifications/Controllers/StepLogRestController.php:289
msgid "Earliest Unix timestamp to include. Defaults to 48 hours before `to`, and is clamped to 90 days before it."
msgstr "Varaseim kaasatav Unixi ajatempel. Vaikimisi 48 tundi enne `to` ja piiratakse 90 päevaga enne seda."

#: src/Internal/PushNotifications/Controllers/StepLogRestController.php:280
msgid "Rows to return, newest first. A page carries every row of its last second, so it can exceed this."
msgstr "Tagastatavad read, uusimad ees. Leht sisaldab iga viimase sekundi rida, seega võib see seda ületada."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:485
msgid "The date a notification for this token was last sent to WordPress.com, as GMT. This records that WordPress.com accepted the payload, not that the device received it. Null when no send has been recorded, which also covers a send whose record failed."
msgstr "Kuupäev, millal selle loa teavitus viimati WordPress.com-ile saadeti, GMT järgi. See salvestab, et WordPress.com võttis andmekoormuse vastu, mitte seda, et seade selle kätte sai. Null, kui ühtegi saatmist pole salvestatud, mis hõlmab ka saatmist, mille salvestamine ebaõnnestus."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:478
msgid "The date the app last registered this token, as GMT. The app re-sends the token periodically, not only when the token value changes, so this shows how recently the app read the token from the device. Null when the date is unknown."
msgstr "Kuupäev, mil rakendus selle tokeni viimati registreeris, GMT järgi. Rakendus saadab tokeni perioodiliselt uuesti, mitte ainult siis, kui tokeni väärtus muutub, seega näitab see, kui hiljuti rakendus tokeni seadmest luges. Null, kui kuupäev on teadmata."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:471
msgid "The date the token was registered, as GMT. Null when the date is unknown."
msgstr "Kuupäev, mil pääsmik registreeriti, GMT-vormingus. Tühi, kui kuupäev pole teada."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:465
msgid "Values the app supplies to describe itself and the device, such as the app and OS version."
msgstr "Väärtused, mida rakendus esitab enda ja seadme kirjeldamiseks, näiteks rakenduse ja OS-i versioon."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:459
msgid "The locale the device is set to."
msgstr "Seadmes määratud lokaat."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:453
msgid "An identifier the app generates for its own install, so a re-registration matches the existing record after the OS issues a new token. Null for browser tokens."
msgstr "Identifikaator, mille rakendus loob oma installi jaoks, et pärast seda, kui OS väljastab uue loa, vastaks uuesti registreerimine olemasolevale kirjele. Brauseri lubade puhul null."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:446
msgid "The app the token was registered from."
msgstr "Rakendus, kust token registreeriti."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:439
msgid "The platform the token was issued for."
msgstr "Platvorm, mille jaoks token väljastati."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:433
msgid "The push token issued by Apple or Google."
msgstr "Apple’i või Google’i väljastatud tõuketoken."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:427
msgid "The email address of the account the token belongs to. Null when the user no longer exists."
msgstr "Selle konto e-posti aadress, millele token kuulub. Null, kui kasutajat enam ei eksisteeri."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:421
msgid "The username of the account the token belongs to. Null when the user no longer exists."
msgstr "Kasutajanimi kontol, millele tunnus kuulub. Null, kui kasutajat enam ei eksisteeri."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:415
msgid "The user the token belongs to."
msgstr "Kasutaja, kellele tunnus kuulub."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:130
msgid "The push tokens registered on this store."
msgstr "Selles poes registreeritud tõukemärgendid."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:116
msgid "Limit results to tokens registered by this device."
msgstr "Piira tulemused selle seadme registreeritud tunnuslubadega."

#: src/Internal/PushNotifications/Controllers/PushTokenRestController.php:109
msgid "Limit results to tokens belonging to this user."
msgstr "Piira tulemused selle kasutaja tokenitega."

#: src/Internal/ProductCustoms/CustomsDataValidator.php:129
msgid "The customs description must be plain text with no more than 35 characters, without emoji or special symbols."
msgstr "Tollikirjeldus peab olema lihttekst, kuni 35 tähemärki, ilma emotikonide või erisümboliteta."

#: src/Internal/ProductCustoms/CustomsDataValidator.php:96
msgid "Select a valid country of origin."
msgstr "Vali kehtiv päritoluriik."

#: src/Internal/ProductCustoms/CustomsDataValidator.php:61
msgid "The customs commodity code must contain 6 to 14 digits, with optional punctuation or spaces."
msgstr "Tollikauba kood peab sisaldama 6 kuni 14 numbrit, valikuliste kirjavahemärkide või tühikutega."

#. translators: %s: Customs value inherited from the parent product.
#: src/Internal/ProductCustoms/ClassicEditorFields.php:105
msgid "Leave blank to inherit from the product: %s."
msgstr "Jäta tühjaks, et pärida tootelt: %s."

#: src/Internal/ProductCustoms/ClassicEditorFields.php:58
msgid "A plain-text description for customs forms, up to 35 characters. Emoji and special symbols are not allowed."
msgstr "Tavateksti kirjeldus tollivormide jaoks, kuni 35 tähemärki. Emodžid ja erisümbolid pole lubatud."

#: src/Internal/ProductCustoms/ClassicEditorFields.php:48
msgid "The country where this product was manufactured or produced."
msgstr "Riik, kus see toode valmistati või toodeti."

#: src/Internal/ProductCustoms/ClassicEditorFields.php:38
msgid "The HS (Harmonized System) code used to classify this product for customs. Enter 6–14 digits; spaces and punctuation are removed."
msgstr "HS-kood (harmoneeritud süsteem), mida kasutatakse selle toote tollis klassifitseerimiseks. Sisesta 6–14 numbrit; tühikud ja kirjavahemärgid eemaldatakse."

#: src/Internal/ProductCustoms/ClassicEditorFields.php:37
msgid "Commodity code"
msgstr "Kaubakood"

#: src/Internal/ProductCustoms/ClassicEditorFields.php:32
msgid "Customs"
msgstr "Toll"

#. translators: %d: number of seconds before another withdrawal request can be
#. submitted.
#: src/Internal/OrderWithdrawal/OrderWithdrawalFormProcessor.php:298
msgid "We could not submit your withdrawal request. Please try again in %d seconds or contact us if the problem continues."
msgstr "Me ei saanud sinu väljamaksetaotlust esitada. Palun proovi uuesti %d sekundi pärast või võta meiega ühendust, kui probleem jätkub."

#: src/Internal/OrderWithdrawal/OrderWithdrawalFeatureHighlightNotification.php:220
msgid "View page"
msgstr "Vaata lehte"

#: src/Internal/OrderWithdrawal/OrderWithdrawalFeatureHighlightNotification.php:212
msgid "Your order withdrawal page is ready. Share its URL wherever customers need access to the withdrawal form, such as your store's terms and conditions."
msgstr "Sinu tellimusest taganemise leht on valmis. Jaga selle URL-i kõikjal, kus klientidel on vaja juurdepääsu taganemisvormile, näiteks sinu poe tingimustes."

#: src/Internal/OrderWithdrawal/OrderWithdrawalFeatureHighlightNotification.php:210
msgid "The order withdrawal feature is enabled"
msgstr "Tellimusest taganemise funktsioon on lubatud"

#: src/Internal/MCP/Transport/WooCommerceRestTransport.php:102
msgid "The WooCommerce MCP endpoint was removed."
msgstr "WooCommerce MCP lõpp-punkt eemaldati."

#. translators: 1: Function or method name, 2: WooCommerce version, 3:
#. Documentation URL.
#: src/Internal/MCP/McpEndpointRemoval.php:303
msgid "%1$s was removed in WooCommerce %2$s along with the WooCommerce MCP endpoint and its REST-based abilities. WooCommerce abilities remain available through the WordPress Abilities API, and the MCP Adapter plugin exposes them to MCP clients. See %3$s."
msgstr "%1$s eemaldati WooCommerce’i versioonis %2$s koos WooCommerce MCP lõpp-punkti ja selle REST-põhiste võimekustega. WooCommerce’i võimekused on jätkuvalt saadaval WordPressi Abilities API kaudu ning MCP Adapteri plugin teeb need MCP klientidele kättesaadavaks. Vaata %3$s."

#. translators: 1: WooCommerce version, 2: MCP Adapter endpoint URL, 3:
#. Documentation URL.
#: src/Internal/MCP/McpEndpointRemoval.php:278
msgid "The WooCommerce MCP endpoint (woocommerce/mcp) was removed in WooCommerce %1$s. To keep using WooCommerce with MCP, install and activate the MCP Adapter plugin (https://wordpress.org/plugins/mcp-adapter/) on this site, then connect your MCP client to %2$s using a WordPress application password. Documentation: %3$s"
msgstr "WooCommerce MCP lõpp-punkt (woocommerce/mcp) eemaldati WooCommerce’i versioonis %1$s. WooCommerce’i MCP-ga kasutamise jätkamiseks paigalda ja aktiveeri sellel saidil MCP Adapteri plugin (https://wordpress.org/plugins/mcp-adapter/), seejärel ühenda oma MCP klient aadressiga %2$s WordPressi rakenduse parooli abil. Dokumentatsioon: %3$s"

#: src/Internal/MCP/McpEndpointRemoval.php:177
msgid "Activate MCP Adapter"
msgstr "Aktiveeri MCP-adapter"

#: src/Internal/MCP/McpEndpointRemoval.php:171
msgid "Install MCP Adapter"
msgstr "Paigalda MCP-adapter"

#: src/Internal/MCP/McpEndpointRemoval.php:170
msgid "MCP Adapter"
msgstr "MCP adapter"

#. translators: %s: WooCommerce version.
#: src/Internal/MCP/McpEndpointRemoval.php:157
msgid "As of WooCommerce %s, the WooCommerce MCP endpoint (/wp-json/woocommerce/mcp), its REST API key authentication, and its REST-based product and order tools are no longer available. WooCommerce abilities are still available through the WordPress Abilities API. Use the MCP Adapter plugin to connect MCP clients to them."
msgstr "Alates WooCommerce %s versioonist ei ole WooCommerce MCP lõpp-punkt (/wp-json/woocommerce/mcp), selle REST API võtme autentimine ning REST-põhised toote- ja tellimustööriistad enam saadaval. WooCommerce’i võimalused on endiselt saadaval WordPress Abilities API kaudu. Kasuta MCP Adapteri pluginat, et ühendada MCP kliendid nendega."

#: src/Internal/MCP/McpEndpointRemoval.php:153
msgid "WooCommerce MCP has been removed."
msgstr "WooCommerce MCP on eemaldatud."

#: src/Internal/Features/FeaturesController.php:761
msgid "Let extensions add their fields to the output of WooCommerce abilities."
msgstr "Luba laiendustel lisada oma väljad WooCommerce’i võimaluste väljundisse."

#: src/Internal/Features/FeaturesController.php:760
msgid "Extensible abilities"
msgstr "Laiendatavad võimalused"

#: src/Internal/Features/FeaturesController.php:653
msgid "Expose the catalog to AI shopping agents through UCP endpoints."
msgstr "Avalda kataloog AI ostuagentidele UCP lõpp-punktide kaudu."

#: src/Internal/Features/FeaturesController.php:652
msgid "Universal Commerce Protocol"
msgstr "Universaalne Commerce'i protokoll"

#: src/Internal/Features/FeaturesController.php:639
msgid "The WooCommerce MCP endpoint was removed. Use the MCP Adapter plugin to access WooCommerce abilities over MCP."
msgstr "WooCommerce’i MCP-lõpp-punkt eemaldati. Kasuta WooCommerce’i võimalustele MCP kaudu juurdepääsemiseks MCP Adapter pluginat."

#: src/Internal/Features/FeaturesController.php:308
msgid "FeaturesController methods that access feature definitions should not be called while feature definitions are being initialized. Use the woocommerce_init action or later."
msgstr "Funktsioonide definitsioonidele ligipääsevaid FeaturesControlleri viise ei tohiks kutsuda ajal, kui funktsioonide definitsioone lähtestatakse. Kasuta toimingut woocommerce_init või hiljem."

#: src/Internal/EmailEditor/PersonalizationTags/OrderTagsProvider.php:309
msgid "Order Review URL"
msgstr "Tellimuse ülevaatamise URL"

#: src/Internal/EmailEditor/EmailApiController.php:716
msgid "The merged block content written to the post. May differ from the input `post_content` even when every choice was `keep_yours`: blocks the merchant never edited take core's version, and the namespace-alias migration (see `aliases_migrated`) rewrites legacy block names unconditionally."
msgstr "Postitusele kirjutatud ühendatud ploki sisu. Võib erineda sisendist `post_content` isegi siis, kui iga valik oli `keep_yours`: plokid, mida kaupmees kunagi ei muutnud, võtavad tuuma versiooni, ja nimeruumi aliase migreerimine (vt `aliases_migrated`) kirjutab pärandplokkide nimed tingimusteta ümber."

#: src/Internal/EmailEditor/EmailApiController.php:351
msgid "Per-conflict apply decisions: an array of {path, decision} entries. `decision` is `keep_yours` or `use_core`. A block with no entry follows the change summary: if only core changed the block, it takes core's version; if the merchant also edited it, it keeps the merchant's version. Without a stored base render, a block with no entry keeps the merchant's version."
msgstr "Konfliktipõhised rakendusotsused: massiiv {path, decision} kirjetest. `decision` on `keep_yours` või `use_core`. Plokk, millel pole kirjet, järgib muudatuste kokkuvõtet: kui ainult tuum muutis plokki, võetakse tuuma versioon; kui kaupmees muutis seda samuti, säilitatakse kaupmehe versioon. Ilma salvestatud baasrenderduseta säilitab kirjeta plokk kaupmehe versiooni."

#: src/Internal/Admin/SiteHealth.php:273
msgid "Anyone with the URL of a downloadable product file can download it without buying the product. Configure your web server to block direct access to the WooCommerce uploads directory."
msgstr "Kõik, kellel on allalaaditava tootefaili URL, saavad selle alla laadida ilma toodet ostmata. Seadista oma veebiserver nii, et see blokeeriks otsese juurdepääsu WooCommerce’i üleslaadimiste kataloogile."

#: src/Internal/Admin/Suggestions/PaymentsExtensionSuggestions.php:3992
msgid "Offer flexible ways to pay: in full, later, or over time. Merchants get paid upfront; Klarna handles credit and fraud risk."
msgstr "Paku paindlikke makseviise: täies ulatuses, hiljem või osamaksetena. Kaupmeestele makstakse ette; Klarna tegeleb krediidi- ja pettuseriskiga."

#: src/Internal/Admin/SiteHealth.php:272
msgid "WooCommerce could not confirm whether downloadable product files can be accessed directly from the web. This happens when test files cannot be written to the uploads directory, your site cannot make requests to itself, or uploads are served from somewhere else, such as a CDN or behind a login."
msgstr "WooCommerce ei suutnud kinnitada, kas allalaaditavatele tootefailidele pääseb otse veebist ligi. See juhtub siis, kui testfaile ei saa üleslaadimiste kataloogi kirjutada, sinu sait ei saa iseendale päringuid teha või üleslaadimisi serveeritakse kuskilt mujalt, näiteks CDN-ist või sisselogimise taga."

#: src/Internal/Admin/SiteHealth.php:262
msgid "Downloadable product files can be accessed directly from the web"
msgstr "Allalaaditava toote failidele pääseb veebist otse juurde"

#: src/Internal/Admin/SiteHealth.php:248
msgid "Downloadable product files cannot be accessed directly from the web."
msgstr "Allalaaditava toote failidele ei pääse veebist otse juurde."

#: src/Internal/Admin/RemoteFreeExtensions/DefaultFreeExtensions.php:600
